{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageFrontmatter",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Page heading and HTML meta title"
    },
    "description": {
      "type": "string",
      "description": "Concise summary for search indexing and SEO meta description"
    },
    "layout": {
      "type": "string",
      "enum": ["doc", "home", "page"],
      "default": "doc"
    },
    "outline": {
      "oneOf": [
        { "type": "number" },
        { "type": "array", "items": { "type": "number" } },
        { "type": "string", "enum": ["deep"] }
      ],
      "default": [2, 3]
    },
    "editLink": {
      "type": "boolean",
      "default": true
    },
    "lastUpdated": {
      "type": "boolean",
      "default": true
    }
  }
}
